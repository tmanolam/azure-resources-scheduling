# demo.tfvars — values for infra/scheduler when deploying into the DEMO tenant.
# (DEMO_TENANT_PLAN §2.3, DM-30.) Copy to demo.tfvars and fill the scope IDs
# from the landing-zone outputs, or let demo/landing-zone/render-demo-tfvars.sh
# generate it for you (DM-14).
#
# The real demo.tfvars is gitignored (*.tfvars); only this .example is committed.
#
# Deploy with the shipped product unchanged, e.g.:
#   terraform -chdir=infra/scheduler init -backend-config=<demo backend.hcl>
#   terraform -chdir=infra/scheduler apply -var-file=../../demo/scheduler/demo.tfvars

subscription_id = "<sub-demo-management-id>"
location        = "southeastasia"

name_suffix = "" # single demo instance

# From landing-zone outputs: role_assignable_scope / in_scope / excluded.
role_assignable_scope = "/providers/Microsoft.Management/managementGroups/demo"

in_scope_management_group_ids = [
  "/providers/Microsoft.Management/managementGroups/demo-landingzones",
  "/providers/Microsoft.Management/managementGroups/demo-sandbox",
]

# Platform MG + the nested sandbox exclude (S9). Production is ALSO hard-excluded
# in the engine via the Environment=Prod subscription tag (BR-003), independent
# of this list.
excluded_scope_ids = [
  "/providers/Microsoft.Management/managementGroups/demo-platform",
  "/providers/Microsoft.Management/managementGroups/demo-sandbox-excluded",
]

# Trim to match the workload toggles enabled in demo/workloads (§4.2).
enabled_resource_types = ["vm", "vmss", "aks", "postgres-flex", "mysql-flex", "sqlmi", "appgw"]

reconcile_schedule  = "0 */15 * * * *" # default; needed for the T-602 count checks
dry_run             = true             # Phase A; flip to false for Phase B (T-603)
max_actions_per_run = 200              # temporarily 2 for scenario S14

log_analytics_workspace_id = ""
alert_email_addresses      = ["<your-demo-alert-email>"]

enable_private_networking = false

tags = {
  owner       = "demo"
  cost-centre = "demo"
  project     = "power-scheduler-demo"
  managed-by  = "terraform"
}
