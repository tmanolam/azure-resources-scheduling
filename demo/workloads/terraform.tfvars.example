# demo/workloads/terraform.tfvars — fill once the subscriptions exist (DM-03).
# Copy to terraform.tfvars (gitignored). All four subscriptions use the credit.

workload_dev_subscription_id  = "<sub-demo-workload-dev-id>"
workload_prod_subscription_id = "<sub-demo-workload-prod-id>"
management_subscription_id    = "<sub-demo-management-id>"

# Leave empty until sub-demo-sandbox is created (Azure quota). When empty, W10
# (the sandbox subscription-inheritance VM) is skipped; set this and re-apply
# once the subscription exists.
sandbox_subscription_id = ""

location       = "southeastasia"
vm_size        = "Standard_B1s"
admin_username = "demoadmin"

standard_profile = "weekday-0830-1730"

# Optional components (§4.2). Keep false during Phase A (dry-run week) to control
# cost; enable W12/W13 at the start of Phase B, and W14 last (destroy after S17).
enable_aks   = false
enable_appgw = false
enable_sqlmi = false
