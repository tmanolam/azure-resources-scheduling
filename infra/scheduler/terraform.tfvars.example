subscription_id = "<management-subscription-id>"
location        = "southeastasia"

# Optional. Leave empty for the standard single tenant-wide deployment.
# Set a short suffix only if you run more than one instance (e.g. "sea").
name_suffix = ""

# Assignable (parent) scope for the custom role definition — the intermediate/org MG.
role_assignable_scope = "/providers/Microsoft.Management/managementGroups/<org>"

# One scheduler for the whole tenant: include the non-production MGs it should manage.
in_scope_management_group_ids = [
  "/providers/Microsoft.Management/managementGroups/<org>-landingzones",
  "/providers/Microsoft.Management/managementGroups/<org>-sandbox",
]

# Scopes always skipped. Production is ALSO hard-excluded in the engine
# (subscriptions tagged environment=prod) regardless of this list (BR-003).
excluded_scope_ids = [
  "/providers/Microsoft.Management/managementGroups/<org>-platform",
]

enabled_resource_types = ["vm", "vmss", "aks", "postgres-flex", "mysql-flex", "sqlmi"]

reconcile_schedule  = "0 */15 * * * *"
dry_run             = true
max_actions_per_run = 200

# Large-tenant scaling (SC-01/SC-04). Defaults are safe for small tenants.
# max_parallel_actions: parallel start/stop submissions per order group (FR-034).
# log_converged_decisions: set false above ~1,000 in-scope resources to control
# Application Insights ingestion (NFR-011); summary counts still cover savings.
max_parallel_actions    = 10
log_converged_decisions = true

log_analytics_workspace_id = ""
alert_email_addresses      = ["cloud-platform@example.com"]

enable_private_networking = false
# integration_subnet_id   = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<snet>"

# DP-06: object ID (an operators *group* recommended) that owns the deployer
# data-plane role assignments (App Configuration Data Owner; Storage Blob Data
# Owner + Queue/Table Data Contributor on the runtime storage account). Leave
# empty to default to whoever runs Terraform. Set it to a stable group so a
# different person/CI can run plan/apply without churning those assignments or
# revoking the previous deployer's access.
# operator_object_id = "<entra-operators-group-object-id>"

tags = {
  owner       = "cloud-platform"
  cost-centre = "<cc>"
  project     = "power-scheduler"
  managed-by  = "terraform"
}
